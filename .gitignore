# dependencies
/node_modules

# next.js
/.next/
/out/
next-env.d.ts

# misc
.DS_Store
*.tsbuildinfo

# env
.env*.local

# vercel
.vercel

# previous project (own git repo)
# The contents, not the directory: git will not re-include a file whose
# parent directory is itself excluded, so `/archive/` + an exception does
# nothing. `/archive/*` excludes what is in it and leaves the door open.
/archive/*
# ...and the note explaining what each variant was, and why it was replaced,
# is prose rather than a build. It belongs in git even though nothing around
# it does.
!/archive/README.md

# client source drop (26MB incl. video); site uses processed copies in public/
/Assets/

# nested variant apps
node_modules/
.next/
out/

# graphify tool output
/graphify-out/
/site/node_modules/
/site/.next/
# verification builds and throwaway dev servers keep their own output
# directory so they can never poison the dev server's .next (see
# site/next.config.ts)
/site/.next-*/
